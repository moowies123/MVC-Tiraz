@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tiraz - Forgot Password</title>
    <link rel="stylesheet" href="/css/ForgetPassword.css?v=1" />
</head>
<body>
    <partial name="_Toast" />

    <div class="auth-card">
        <form asp-action="ForgetPassword" method="post">
            <h1>Forgot Password?</h1>
            <p class="subtitle">Enter your email and we'll send you a link to reset your password.</p>

            <input type="email" name="Email" placeholder="Email" required />

            <button type="submit" href="/Identity/Account/VerifyOtp">Send Reset Link</button>

            <a asp-action="Login" class="back-btn">Back to sign in</a>
        </form>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>