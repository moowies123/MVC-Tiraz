@model MVC_Tiraz.ViewModels.ResetPasswordVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tiraz - Reset Password</title>
    <link rel="stylesheet" href="/css/ForgetPassword.css?v=2" />
</head>
<body>
       <div asp-validation-summary="All" class="error-summary"></div>
    <partial name="_Toast" />

    <div class="auth-card">
        <form asp-action="ResetPassword" method="post" novalidate>

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <h1>Reset Password</h1>
            <p class="subtitle">Choose a new password for your account.</p>

            <div asp-validation-summary="ModelOnly" class="error-summary"></div>

            <input asp-for="Email" autocomplete="username" style="display:none" />

            <input asp-for="Password" placeholder="New password" />
            <span asp-validation-for="Password"></span>

            <input asp-for="ConfirmPassword" placeholder="Confirm new password" />
            <span asp-validation-for="ConfirmPassword"></span>

            <button type="submit" >Reset Password</button>

            <a asp-action="Login" class="back-btn">Back to sign in</a>
        </form>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>