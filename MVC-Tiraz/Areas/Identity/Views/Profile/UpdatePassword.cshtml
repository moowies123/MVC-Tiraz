@model MVC_Tiraz.ViewModels.ApplicationUserVM
@{
    Layout = null;
    ViewData["Active"] = "password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tiraz - Update Password</title>
    <link rel="stylesheet" href="/css/Profile.css?v=1" />
</head>
<body>
    <partial name="_Toast" />

    <div class="profile-layout">
        <partial name="_ProfileSidebar" />

        <main class="content">
            <div class="content-inner narrow">
                <div class="page-header">
                    <h1>Update Password</h1>
                    <p>Enter your current password, then choose a new one.</p>
                </div>

                <div class="card">
                    <form asp-action="UpdatePassword" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="error-summary"></div>

                        <div class="form-grid single">
                            <div class="form-group">
                                <label asp-for="CurrentPassword">Current Password</label>
                                <input asp-for="CurrentPassword" placeholder="Current password" autocomplete="current-password" />
                                <span asp-validation-for="CurrentPassword"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="NewPassword">New Password</label>
                                <input asp-for="NewPassword" placeholder="New password" autocomplete="new-password" />
                                <span asp-validation-for="NewPassword"></span>
                                <span class="form-hint">At least 6 characters.</span>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="action-btn action-primary">Update Password</button>
                            <a asp-action="UserInfo" class="action-btn action-outline">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
