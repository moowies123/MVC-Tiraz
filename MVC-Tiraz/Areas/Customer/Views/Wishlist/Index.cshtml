@model IEnumerable<Wishlist>
@{
    Layout = null;
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wishlist | TIRAZ</title>
    <link rel="stylesheet" href="@Url.Content("~/css/home.css")?v=1" />
    <link rel="stylesheet" href="@Url.Content("~/css/wishlist.css")?v=1" />
    <script src="@Url.Content("~/js/theme.js")?v=2"></script>
</head>
<body>

    <!-- ================= NAVBAR ================= -->
    <header class="topbar">
        <div class="topbar-left">
            <button type="button" class="icon-btn menu-btn" id="menuBtn"
                    aria-label="Open menu" aria-controls="menuPanel" aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
        </div>

        <a class="brand" href="/">TIRAZ</a>

        <div class="topbar-right">
            <!-- the cart panel lives on the home page -->
            <a class="icon-btn" href="/Customer/Home/Index" aria-label="Back to shop">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h8.8a1 1 0 0 0 1-.8L20 8H6" /><circle cx="9.5" cy="20" r="1.3" /><circle cx="17" cy="20" r="1.3" /></svg>
            </a>

            <div class="profile">
                <button type="button" class="icon-btn profile-btn" id="profileBtn"
                        aria-label="Account menu" aria-haspopup="menu" aria-expanded="false" aria-controls="profileMenu">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" /></svg>
                </button>

                <div class="dropdown" id="profileMenu" role="menu">
                    @if (isLoggedIn)
                    {
                        <a class="item" role="menuitem" href="/Identity/Profile/UserInfo">Account</a>
                        <a class="item" role="menuitem" href="/Customer/Wishlist/Index">Wishlist</a>
                        <form method="post" action="/Identity/Account/Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="item" role="menuitem">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="item" role="menuitem" href="/Identity/Account/Login">Login / Register</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <div class="overlay" id="overlay"></div>

    <aside class="panel panel-left" id="menuPanel" aria-label="Menu" aria-hidden="true">
        <div class="panel-head">
            <span class="panel-title">MENU</span>
            <button type="button" class="icon-btn" data-close aria-label="Close menu">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
        </div>
        <nav class="panel-links">
            <a href="/Customer/Home/Index">Shop</a>
            <a href="/Customer/Wishlist/Index">Wishlist</a>
        </nav>
    </aside>

    <!-- ================= WISHLIST ================= -->
    <main class="wl-page">
        <div class="wl-head">
            <h1>WISHLIST</h1>
            <span class="wl-count">@Model.Count() @(Model.Count() == 1 ? "item" : "items")</span>
        </div>

        @if (!Model.Any())
        {
            <div class="wl-empty">
                <p>Your wishlist is empty.</p>
                <a class="wl-btn" href="/Customer/Home/Index">Browse the shop</a>
            </div>
        }
        else
        {
            <div class="wl-grid">
                @foreach (var item in Model)
                {
                    var p = item.Product;
                    var img = p.Images?.OrderBy(i => i.ProductImageId).Select(i => i.Url).FirstOrDefault();
                    var hasDiscount = (p.Discount ?? 0) > 0;
                    var finalPrice = p.Price - p.Price * (p.Discount ?? 0) / 100;

                    <article class="wl-card">
                        <a class="wl-photo" href="@Url.Action("ProductDetails", "Home", new { area = "Customer", id = p.ProductId })">
                            @if (!string.IsNullOrEmpty(img))
                            {
                                <img src="@Url.Content(img)" alt="@p.Name" loading="lazy" />
                            }
                            else
                            {
                                <span class="wl-noimg">TIRAZ</span>
                            }
                        </a>

                        <div class="wl-body">
                            <span class="wl-cat">@p.Category?.Name</span>
                            <h2>@p.Name</h2>
                            <div class="wl-price">
                                <strong>$@finalPrice.ToString("0.00")</strong>
                                @if (hasDiscount)
                                {
                                    <s>$@p.Price.ToString("0.00")</s>
                                }
                            </div>

                            <div class="wl-actions">
                                <a class="wl-btn" href="@Url.Action("ProductDetails", "Home", new { area = "Customer", id = p.ProductId })">View Details</a>

                                <form method="post" action="/Customer/Wishlist/Remove">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.ProductId" />
                                    <button type="submit" class="wl-btn wl-btn-outline">Remove</button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </main>

    <script>
            (function () {
                var body = document.body, overlay = document.getElementById("overlay");
                var profileBtn = document.getElementById("profileBtn");
                var profileMenu = document.getElementById("profileMenu");
                var profile = profileBtn.parentElement;
                var menuBtn = document.getElementById("menuBtn");
                var menuPanel = document.getElementById("menuPanel");

                function setProfile(open) {
                    profileMenu.classList.toggle("open", open);
                    profileBtn.setAttribute("aria-expanded", open ? "true" : "false");
                }
                function setMenu(open) {
                    menuPanel.classList.toggle("open", open);
                    menuPanel.setAttribute("aria-hidden", open ? "false" : "true");
                    menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
                    overlay.classList.toggle("show", open);
                    body.classList.toggle("no-scroll", open);
                }

                profileBtn.addEventListener("click", function () { setProfile(!profileMenu.classList.contains("open")); });
                document.addEventListener("click", function (e) { if (!profile.contains(e.target)) setProfile(false); });
                menuBtn.addEventListener("click", function () { setProfile(false); setMenu(true); });
                menuPanel.querySelector("[data-close]").addEventListener("click", function () { setMenu(false); });
                overlay.addEventListener("click", function () { setMenu(false); });
                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape") { setProfile(false); setMenu(false); }
                });
            })();
    </script>
</body>
</html>
