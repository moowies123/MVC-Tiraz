@model Category
@{
    ViewData["Title"] = "Create Category";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .input-validation-error {
        border-color: #dc3545 !important;
    }
</style>

<div class="card shadow-sm border-0" style="max-width: 600px;">
    <div class="card-header bg-white fw-bold">New Category</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @* <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div> *@

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-semibold">Name</label>
                <input asp-for="Name" class="form-control" placeholder="Category name" autofocus />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label for="status" class="form-label">Status</label>
                <select name="Status" class="form-select">
                    <option value="True" selected>Active</option>
                    <option value="False">In Active</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" asp-action="Create" class="btn btn-dark">
                    <i class="bi bi-check-lg me-1"></i> Create
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
