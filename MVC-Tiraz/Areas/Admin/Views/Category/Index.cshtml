@model IEnumerable<Category>
@{
	ViewData["Title"] = "Categories";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Top row: description on the left, Create button on the right -->
<div class="d-flex justify-content-between align-items-center mb-3">
	<p class="text-muted mb-0">Manage your product categories.</p>

	<a href="/Admin/Category/Create" class="btn btn-dark">
		<i class="bi bi-plus-lg me-1"></i> Create
	</a>
</div>

<div class="card shadow-sm border-0">
	<div class="card-body p-0">
		<table class="table table-hover align-middle mb-0">
			<thead class="table-light">
				<tr>
					<th style="width: 120px;">Id</th>
					<th>Name</th>
					<th>Status</th>
					<th class="text-end" style="width: 220px;">Edit/Delete</th>
				</tr>
			</thead>
			<tbody>
				@if (!Model.Any())
				{
					<tr>
						<td colspan="3" class="text-center text-muted py-4">No categories yet.</td>
					</tr>
				}

				@foreach (var item in Model)
				{
					<tr>
						<td>@item.CategoryId</td>

						<td class="fw-semibold">@item.Name</td>

						@if (!item.Status)
						{
							<td class="fw-semibold" style="color:red">In Active</td>
						}
						else
						{
							<td class="fw-semibold" style="color:limegreen">Active</td>
						}

						@if (User.IsInRole(CD.SUPER_ADMIN_ROLE) || User.IsInRole(CD.ADMIN_ROLE))
						{
							<td class="text-end">
								<a type="button" href="/Admin/Category/Update" asp-route-id="@item.CategoryId" class="btn btn-dark btn-sm">
									<i class="bi bi-pencil-square me-1"></i> Edit
								</a>

								<a type="button" href="/Admin/Category/Delete" asp-route-id="@item.CategoryId" class="btn btn-danger btn-sm">
									<i class="bi bi-trash me-1"></i> Delete
								</a>
							</td>
						}
						else
						{
							<td class="text-end">
								<a class="btn btn-dark btn-sm">
									<i class="bi bi-pencil-square me-1"></i> No Access
								</a>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

<script>
	document.querySelectorAll(".btn-delete").forEach(button => {
		button.addEventListener("click", function (e) {
			e.preventDefault();

			const deleteUrl = this.getAttribute("href");

			Swal.fire({
				title: "Are you sure?",
				text: "You won't be able to recover this category!",
				icon: "warning",
				showCancelButton: true,
				confirmButtonColor: "#d33",
				cancelButtonColor: "#6c757d",
				confirmButtonText: "Yes, delete it!",
				cancelButtonText: "Cancel"
			}).then((result) => {
				if (result.isConfirmed) {
					window.location.href = deleteUrl;
				}
			});
		});
	});
</script>