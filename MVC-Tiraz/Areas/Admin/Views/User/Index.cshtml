@model IEnumerable<ApplicationUserVM>
@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Top row: description on the left, Create button on the right -->
<div class="d-flex justify-content-between align-item.Users-center mb-3">
    <p class="text-muted mb-0">User Management</p>

    <a asp-action="CreateUser" class="btn btn-dark">
        <i class="bi bi-plus-lg me-1"></i> Add User
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">Id</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Confirmation</th>
                        <th>Role</th>
                        <th class="text-end" style="width: 220px;">Lock/UnLock</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.User.Id</td>

                            <td class="fw-semibold">@item.User.FirstName</td>

                            <td class="fw-semibold">@item.User.LastName</td>
                            
                            <td class="fw-semibold">@item.User.UserName</td>

                            <td class="fw-semibold">@item.User.Email</td>

                            @if (!item.User.EmailConfirmed)
                            {
                                <td class="fw-semibold" style="color:red">In Active</td>
                            }
                            else
                            {
                                <td class="fw-semibold" style="color:limegreen">Active</td>
                            }

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <td class="fw-semibold">
                                    <strong>@item.Role</strong>
                                </td>
                            }

                            @if (item.User.LockoutEnd == null || item.User.LockoutEnd < DateTime.UtcNow)
                            {
                                <td class="text-end text-nowrap">
                                    <a asp-action="LockUnLock" asp-route-id="@item.User.Id" class="btn btn-danger btn-lg">
                                        <i class=""></i> Lock
                                    </a>
                                </td>
                            }
                            else
                            {
                                <td class="text-end text-nowrap">
                                    <a asp-action="LockUnLock" asp-route-id="@item.User.Id" class="btn btn-success btn-lg">
                                        <i class=""></i> UnLock
                                    </a>
                                </td>
                            }
                            <td class="text-end text-nowrap">
                                <a asp-action="UpdateUser" asp-route-id="@item.User.Id" class="btn btn-success btn-lg">
                                    <i class=""></i> Update
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_NotificationPartial"/>
}
