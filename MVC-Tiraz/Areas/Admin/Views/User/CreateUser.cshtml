@model ApplicationUserVM
@{
	ViewData["Title"] = "Update User";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
	.input-validation-error {
		border-color: #dc3545 !important;
	}
</style>

<div class="card shadow-sm border-0" style="max-width: 600px;">
	<div class="card-header bg-white fw-bold">Edit User</div>
	<div class="card-body">
		<form asp-action="CreateUser" method="post">
			<div asp-validation-summary="All" class="text-danger mb-3"></div>

			<div class="mb-4">
				<label asp-for="@Model.FirstName" class="form-label fw-semibold">First Name</label>
				<input asp-for="@Model.FirstName" class="form-control" placeholder="First Name" />
				<span asp-validation-for="@Model.FirstName" class="text-danger small"></span>
			</div>

			<div class="mb-4">
				<label asp-for="@Model.LastName" class="form-label fw-semibold">Last Name</label>
				<input asp-for="@Model.LastName" class="form-control" placeholder="Last Name" />
				<span asp-validation-for="@Model.LastName" class="text-danger small"></span>
			</div>

			<div class="mb-4">
				<label asp-for="@Model.UserName" class="form-label fw-semibold">UserName</label>
				<input asp-for="@Model.UserName" class="form-control" />
				<span asp-validation-for="@Model.UserName" class="text-danger small"></span>
			</div>

			<div class="mb-4">
				<label asp-for="@Model.Email" class="form-label fw-semibold">Email</label>
				<input asp-for="@Model.Email" class="form-control" placeholder="Email Address" />
				<span asp-validation-for="@Model.Email" class="text-danger small"></span>
			</div>

			<div class="mb-4">
				<label asp-for="@Model.Address" class="form-label fw-semibold">Address</label>
				<input asp-for="@Model.Address" class="form-control" placeholder="Your real Address" />
				<span asp-validation-for="@Model.Address" class="text-danger small"></span>
			</div>

			<div class="mb-4">
				<label asp-for="@Model.NewPassword" class="form-label fw-semibold">Password</label>
				<input asp-for="@Model.NewPassword" class="form-control" placeholder="Password" />
				<span asp-validation-for="@Model.NewPassword" class="text-danger small"></span>
			</div>

			<div class="mb-4">
				<label asp-for="@Model.ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
				<input asp-for="@Model.ConfirmPassword" class="form-control" placeholder="Enter the password again" />
				<span asp-validation-for="@Model.ConfirmPassword" class="text-danger small"></span>
			</div>

			<div class="col-md-6">
				<label asp-for="Role"
					   class="form-label fw-semibold">Role</label>

				<select asp-for="Role"
						asp-items="Model.Roles"
						class="form-select">
					<option value="">-- Select Role --</option>
				</select>

				<span asp-validation-for="Role"
					  class="text-danger small"></span>
			</div>

			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-primary mt-3">
					Create User
				</button>
				<a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
