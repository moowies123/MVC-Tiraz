@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Category names for the table. The Index action puts the categories in ViewBag.Categories.
    var categoryNames = (ViewData["Categories"] as IEnumerable<Category> ?? Enumerable.Empty<Category>())
        .ToDictionary(c => c.CategoryId, c => c.Name);
}

<!-- Top row: description on the left, Create button on the right -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Manage your products, sizes, colors and stock.</p>

    <a asp-action="Create" class="btn btn-dark">
        <i class="bi bi-plus-lg me-1"></i> Create
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">Id</th>
                        <th style="width: 80px;">Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Sizes</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 220px;">Edit/Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No products yet.</td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ProductId</td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.Image))
                                {
                                    <img src="@item.Image" alt="@item.Name" class="rounded border"
                                         style="width: 48px; height: 48px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted"
                                         style="width: 48px; height: 48px;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                            </td>

                            <td class="fw-semibold">@item.Name</td>

                            <td>@(categoryNames.GetValueOrDefault(item.CategoryId, "-"))</td>

                            <td>@item.Price.ToString("C")</td>

                            @* Hover a size to see its colors and quantities *@
                            <td>
                                @foreach (var size in item.Sizes.OrderBy(s => s.ProductSizeId))
                                {
                                    var tip = string.Join(", ", size.Colors.Select(c => $"{c.Color} ({c.Quantity})"));
                                    <span class="badge bg-light text-dark border me-1" title="@tip">@size.Size</span>
                                }
                            </td>

                            <td>
                                @if (item.TotalStock == 0)
                                {
                                    <span class="badge bg-danger">Out of stock</span>
                                }
                                else
                                {
                                    @item.TotalStock
                                }
                            </td>

                            @if (!item.Status)
                            {
                                <td class="fw-semibold" style="color:red">In Active</td>
                            }
                            else
                            {
                                <td class="fw-semibold" style="color:limegreen">Active</td>
                            }

                            @if (User.IsInRole(CD.SUPER_ADMIN_ROLE) || User.IsInRole(CD.ADMIN_ROLE))
                            {
                                <td class="text-end text-nowrap">
                                    <a asp-action="Update" asp-route-id="@item.ProductId" class="btn btn-dark btn-sm">
                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                    </a>

                                    @if (User.IsInRole(CD.SUPER_ADMIN_ROLE))
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.ProductId" method="post" class="d-inline delete-form">
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    }
                                </td>
                            }
                            else
                            {
                                <td class="text-end">
                                    <a class="btn btn-dark btn-sm disabled">
                                        <i class="bi bi-pencil-square me-1"></i> No Access
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    @* Remove this line if _AdminLayout already loads SweetAlert2 *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.querySelectorAll(".delete-form").forEach(form => {
            form.addEventListener("submit", function (e) {
                e.preventDefault();

                if (typeof Swal === "undefined") {
                    if (confirm("Delete this product? This cannot be undone.")) form.submit();
                    return;
                }

                Swal.fire({
                    title: "Are you sure?",
                    text: "You won't be able to recover this product!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Yes, delete it!",
                    cancelButtonText: "Cancel"
                }).then(result => {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}
